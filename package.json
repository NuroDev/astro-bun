{
  "private": true,
  "name": "astro-bun",
  "workspaces": [
    "./package/",
    "./playground/"
  ],
  "packageManager": "bun@1.3.2",
  "scripts": {
    "build": "bun run --filter '*' build",
    "check": "biome check .",
    "dev": "bun run --filter '*' dev",
    "format": "biome format --write .",
    "lint": "biome lint --write . --error-on-warnings",
    "test": "bun run --filter '*' test",
    "type-check": "bun run --filter '*' type-check"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.4"
  }
}
